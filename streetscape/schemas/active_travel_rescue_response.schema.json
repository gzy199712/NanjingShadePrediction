{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Active-travel visibility rescue response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "point_id", "view_headings", "scene_type", "active_travel_visible", "walkable_regions", "occlusion", "rescue_decision", "confidence", "evidence", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "point_id": {"type": "string", "minLength": 1},
    "view_headings": {"type": "array", "items": {"type": "integer", "enum": [0, 90, 180, 270]}, "uniqueItems": true},
    "scene_type": {"enum": ["public_sidewalk", "shared_walk_cycle", "pedestrian_space", "motor_vehicle_only", "covered_infrastructure", "uncertain"]},
    "active_travel_visible": {"enum": ["yes", "no", "uncertain"]},
    "walkable_regions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "bbox_norm", "kind", "confidence"],
        "properties": {
          "heading": {"type": "integer", "enum": [0, 90, 180, 270]},
          "bbox_norm": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 4, "maxItems": 4},
          "kind": {"enum": ["sidewalk", "cycle_lane", "shared_path", "pedestrian_area", "crossing", "uncertain"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "occlusion": {"enum": ["none", "vehicles", "vegetation", "barrier", "geometry", "blur", "other", "uncertain"]},
    "rescue_decision": {"enum": ["PROMOTE_TO_GROUNDING", "KEEP_ABSTAIN", "EXCLUDE_MOTOR_ONLY", "REQUEST_8_VIEWS"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "warnings": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 300}}
  }
}
